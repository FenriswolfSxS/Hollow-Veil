{
  "name": "hollow-veil-fc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cf:dev": "wrangler pages dev dist --d1 DB=hollow-veil-db",
    "db:migrate:local": "wrangler d1 migrations apply hollow-veil-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hollow-veil-db --remote"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}